# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Optional server-side passcode for the /admin content management console.
# If left unset, /admin provides a one-time setup form to claim an admin password.
ADMIN_PASSCODE=

# VITE_API_BASE_URL: Optional external backend base URL when deploying the frontend on Vercel
# separately from the Express/SQLite server (leave empty to use same-origin /api/* routes).
VITE_API_BASE_URL=

# ALLOWED_ORIGINS: Comma-separated list of allowed frontend origins for CORS on /api/*
# (e.g., https://studentexchange.vercel.app).
ALLOWED_ORIGINS=

